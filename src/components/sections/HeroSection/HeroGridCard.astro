---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Props = {
  span: string;
  image: { src: ImageMetadata; alt: string };
  heading: string;
  tagline: string;
};

const { span, image, heading, tagline } = Astro.props;
---

<div
  class:list={['group relative col-span-1 flex flex-col justify-between', span]}
>
  <div
    class="relative h-full rounded-[10px] border border-light border-opacity-75 bg-purp px-8 py-10"
  >
    <div class="relative h-40 w-40">
      <div
        class="absolute h-full w-full translate-x-1 translate-y-1 rounded-[10px] bg-purp-light"
      >
      </div>
      <Image
        class="relative h-full w-full overflow-hidden rounded-[10px] object-cover"
        src={image.src}
        alt={image.alt}
        width={160}
        height={160}
        densities={[1, 2]}
      />
    </div>
    <div class="mt-12">
      <p class="text-copy">{tagline}</p>
      <h3 class="mt-4 font-brand text-2xl font-bold text-white">{heading}</h3>
    </div>
  </div>
</div>
