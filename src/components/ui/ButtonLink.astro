---
type Props = { href: string; openInNewTab?: boolean };

const { href, openInNewTab } = Astro.props;
---

<a
  href={href}
  target={openInNewTab ? '_blank' : undefined}
  rel={openInNewTab ? 'noopener noreferrer' : undefined}
  class="group relative"
>
  <div class="absolute bottom-0 h-full w-full rounded-[10px] border-2 border-purp bg-transparent"></div>
  <div class="transform-gpu rounded-[10px] bg-purp px-4 py-2 text-sm font-semibold text-white transition group-hover:-translate-x-1 group-hover:-translate-y-1 group-active:translate-x-0 group-active:translate-y-0 md:text-lg">
    <slot />
  </div>
</a>
