---
import OpenClose from '@/components/icons/OpenClose.astro';
import { HEADER_HEIGHT } from '@/lib/constants';
import NavLink from './NavLink.astro';
import { logo, navLinks } from './navLinks';

// Closed by default; the script below flips data-open
---

<div class="group/menu md:hidden" data-mobile-menu data-open="false">
  <div class="flex w-full items-center justify-between px-[10%] py-4">
    <a class="z-10" href="/">
      <img class="h-12" src={logo.src} width={80} height={100} alt={logo.alt} />
    </a>
    <button
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-mobile-menu-toggle
    >
      <OpenClose />
    </button>
  </div>

  <nav id="mobile-nav" inert>
    {
      navLinks.map((link, index) => (
        <div
          class="absolute flex h-24 w-full translate-x-full items-center justify-center bg-black text-white transition-transform [transition-delay:var(--close-delay)] group-data-[open=true]/menu:translate-x-0 group-data-[open=true]/menu:[transition-delay:var(--open-delay)]"
          style={{
            top: `${HEADER_HEIGHT + index * 64}px`,
            '--open-delay': `${index * 0.1}s`,
            '--close-delay': `${(navLinks.length - index) * 0.1}s`,
          }}
        >
          <div class="absolute z-0 h-full w-full bg-dark-blue opacity-50" />
          <NavLink {...link} />
        </div>
      ))
    }
  </nav>
</div>

<script>
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')!;
  const toggle = menu.querySelector<HTMLElement>('[data-mobile-menu-toggle]')!;
  const nav = menu.querySelector<HTMLElement>('#mobile-nav')!;

  const setOpen = (open: boolean) => {
    menu.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    // Off-screen links shouldn't be reachable with the keyboard while closed
    nav.inert = !open;
  };

  toggle.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));

  // Links like /#about stay on the same page, so close the menu behind them
  nav.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });

  menu.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.dataset.open === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
