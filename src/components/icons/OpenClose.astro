---
// Hamburger that turns into an X when an ancestor `group/menu` has data-open="true"
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class="h-8 w-8 rotate-0 transition ease-in-out group-data-[open=true]/menu:rotate-90"
  aria-hidden="true"
>
  <path
    class="fill-purp-light opacity-100 group-data-[open=true]/menu:opacity-0"
    fill-rule="evenodd"
    d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75Z"
  ></path>
  <path
    class="origin-center rotate-0 fill-purp-light group-data-[open=true]/menu:-rotate-45"
    fill-rule="evenodd"
    d="M3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Z"
  ></path>
  <path
    class="origin-center rotate-0 fill-purp group-data-[open=true]/menu:rotate-45"
    fill-rule="evenodd"
    d="M3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Z"
  ></path>
  <path
    class="fill-purp-light opacity-100 group-data-[open=true]/menu:opacity-0"
    fill-rule="evenodd"
    d="M3 17.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z"
  ></path>
