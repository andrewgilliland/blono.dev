---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '@/styles/fonts.css';
import '@/styles/globals.css';
import defaultImage from '@/assets/bnd-peeps-1.jpg';
import Header from '@/components/layout/Header/index.astro';
import Footer from '@/components/layout/Footer.astro';
import { HEADER_HEIGHT } from '@/lib/constants';

const SITE_NAME = 'Bloomington-Normal Developers';

type Props = {
  // The page's own title; the site name is appended
  title?: string;
  description?: string;
  // Shown in link previews; defaults to the community photo
  image?: ImageMetadata;
  // For pages that shouldn't be indexed, like the 404 page
  noindex?: boolean;
};

const {
  title,
  description = "Bloomington-Normal's group for professional software developers and designers.",
  image = defaultImage,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const pageUrl = new URL(Astro.url.pathname, Astro.site);

// Link previews need an absolute URL to a raster image. Cards are 1200x630 (1.91:1);
// smaller photos are cropped to that shape at their own size, since Astro won't enlarge
const scale = Math.min(1, image.width / 1200, image.height / 630);
const previewWidth = Math.round(1200 * scale);
const previewHeight = Math.round(630 * scale);
const previewImage = await getImage({
  src: image,
  width: previewWidth,
  height: previewHeight,
  format: 'jpg',
});
const imageUrl = new URL(previewImage.src, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth font-brand">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(previewWidth)} />
    <meta property="og:image:height" content={String(previewHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="leading-base bg-gray-900 text-lg text-white antialiased">
    <div class="flex flex-col bg-dark">
      <Header />
      <main
        class="min-h-screen px-8"
        style={{ marginTop: `${HEADER_HEIGHT}px` }}
      >
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // ADR-0001: re-evaluate Upcoming vs Past against the viewer's clock
      import { applyUpcomingCheck } from '@/scripts/upcoming';

      applyUpcomingCheck(document, new Date());
    </script>
  </body>
</html>
